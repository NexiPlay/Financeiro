PORT=3001

# Postgres do projeto Supabase (Settings > Database > Connection string)
DATABASE_URL="postgresql://postgres:SENHA@db.SEU_PROJETO.supabase.co:5432/postgres"

# Settings > API no painel do Supabase
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_ANON_KEY=""

# Settings > API > service_role key. NUNCA exponha essa chave ao frontend —
# ela ignora Row Level Security e dá acesso total ao projeto Supabase.
# Usada só no backend, pelo módulo de Usuários (criar/listar/alterar papel).
SUPABASE_SERVICE_ROLE_KEY=""
