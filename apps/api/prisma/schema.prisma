generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContaPagar {
  id            String   @id @default(uuid())
  fornecedor    String
  descricao     String
  vencimento    DateTime
  valor         Decimal  @db.Decimal(12, 2)
  status        String
  parcelaAtual  Int?
  totalParcelas Int?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@map("contas_pagar")
}

model ContaReceber {
  id            String   @id @default(uuid())
  cliente       String
  descricao     String
  vencimento    DateTime
  valor         Decimal  @db.Decimal(12, 2)
  status        String
  parcelaAtual  Int?
  totalParcelas Int?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@map("contas_receber")
}

model Funcionario {
  id           String   @id @default(uuid())
  nome         String
  cargo        String
  departamento String
  admissao     DateTime
  salarioBase  Decimal  @db.Decimal(12, 2)
  status       String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("funcionarios")
}

model CompetenciaFolha {
  id                String   @id @default(uuid())
  competencia       String
  totalFuncionarios Int
  proventos         Decimal? @db.Decimal(12, 2)
  descontos         Decimal? @db.Decimal(12, 2)
  liquido           Decimal? @db.Decimal(12, 2)
  status            String
  criadoEm          DateTime @default(now())

  @@map("competencias_folha")
}

model MovimentacaoCaixa {
  id        String   @id @default(uuid())
  data      DateTime
  descricao String
  tipo      String
  valor     Decimal  @db.Decimal(12, 2)
  criadoEm  DateTime @default(now())

  @@map("movimentacoes_caixa")
}

model LogAuditoria {
  id       String   @id @default(uuid())
  dataHora DateTime @default(now())
  usuario  String
  acao     String
  modulo   String

  @@map("log_auditoria")
}
